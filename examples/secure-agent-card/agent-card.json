{
  "protocolVersion": "0.3.0",
  "name": "TextPartCounterAgent",
  "description": "Validates each message it is sent and replies with the number of text parts it received and the total number of characters in them.",
  "supportedInterfaces": [
    { "url": "https://your-agent.example.com", "protocolBinding": "JSONRPC", "protocolVersion": "1.0" },
    { "url": "https://your-agent.example.com", "protocolBinding": "HTTP+JSON", "protocolVersion": "1.0" },
    { "url": "https://your-agent.example.com", "protocolBinding": "JSONRPC", "protocolVersion": "0.3" }
  ],
  "url": "https://your-agent.example.com",
  "preferredTransport": "JSONRPC",
  "version": "3.0.0",
  "documentationUrl": "https://your-agent.example.com/docs",
  "provider": {
    "organization": "Your Organization",
    "url": "https://your-org.example.com"
  },
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "stateTransitionHistory": false
  },
  "securitySchemes": {
    "bearer": { "httpAuthSecurityScheme": { "scheme": "Bearer" }, "type": "http", "scheme": "bearer" }
  },
  "securityRequirements": [{ "schemes": { "bearer": { "list": [] } } }],
  "security": [{ "bearer": [] }],
  "defaultInputModes": ["text/plain", "application/json", "application/pdf", "image/png", "image/jpeg"],
  "defaultOutputModes": ["text/plain"],
  "skills": [
    {
      "id": "count-text-parts",
      "name": "Count Text Parts",
      "description": "Reply with the number of text parts in the message and the total number of characters in them. File parts are accepted and not decoded.",
      "tags": ["example"],
      "examples": [
        "Count the text parts in this message"
      ]
    }
  ]
}
